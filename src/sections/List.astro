---
import { works } from "../data/Works"

function addRandomBlanks(arr: string[], count = 3): string[]{
    const newArr = [...arr];

    for (let i = 0; i < count; i++) {
        const randomIndex = Math.floor(Math.random() * (newArr.length + 1));
        newArr.splice(randomIndex, 0, ""); // Inserta un string vacío en posición aleatoria
    }

    return newArr;
    }

---

<section class="h-[200dvh] text-[#1e1e1e] mx-5 lg:mx-10">
    <ul class="md:hidden">
        {works.map((el, i) => {
            return <li class='my-5'>
                <div class="my-2">{el.title}</div>
                <ul class="grid grid-cols-2 gap-3">
                    {addRandomBlanks(el.images).map((img, i) => {
                        return <li class={`flex flex-col justify-end ${i === 2 || i === 5 ? 'col-span-2 min-h-[600px]' : 'col-span-1 min-h-[300px]'}`}>
                            <div id="article-img">
                                {img !== "" ? (
                                    <img
                                    src={`images/${img}`}
                                    alt="images"
                                    class="object-cover size-full"
                                    loading="lazy"
                                    decoding="async"
                                    />
                                ) : (
                                    <div class="w-full h-full" />
                                )}
                            </div>
                            <p class="font-black text-xs">{'0'+(i + 1)}</p>
                        </li>
                    })}
                </ul>
            </li>
        })}
    </ul>
    <ul class="hidden md:block">
        {works.map((el, i) => {
            return <li class='my-5 lg:my-10'>
                <div class="my-2 uppercase font-black text-xs">{el.title}</div>
                <ul class="grid grid-cols-16 gap-3">
                    {addRandomBlanks(el.images).map((img, i) => {
                        return <li class={`flex flex-col justify-end col-span-2 min-h-[300px]}`}>
                            <div id="article-img">
                                {img !== "" ? (
                                    <img
                                    src={`images/${img}`}
                                    alt="images"
                                    class="object-cover size-full"
                                    loading="lazy"
                                    decoding="async"
                                    />
                                ) : (
                                    <div class="w-full h-full" />
                                )}
                            </div>
                            <p class="font-black text-xs">{'0'+(i + 1)}</p>
                        </li>
                    })}
                </ul>
            </li>
        })}
    </ul>
    <ul class="hidden md:block">
        {works.map((el, i) => {
            return <li class='my-5 lg:my-10'>
                <div class="my-2 uppercase font-black text-xs">{el.title}</div>
                <ul class="grid grid-cols-16 gap-3">
                    {addRandomBlanks(el.images).map((img, i) => {
                        return <li class={`flex flex-col justify-end col-span-2 min-h-[300px]}`}>
                            <div id="article-img">
                                {img !== "" ? (
                                    <img
                                    src={`images/${img}`}
                                    alt="images"
                                    class="size-full object-cover"
                                    loading="lazy"
                                    decoding="async"
                                    />
                                ) : (
                                    <div class="w-full h-full" />
                                )}
                            </div>
                            <p class="font-black text-xs">{'0'+(i + 1)}</p>
                        </li>
                    })}
                </ul>
            </li>
        })}
    </ul>
</section>

<script type="module">

    import { animate, inView } from "https://cdn.jsdelivr.net/npm/motion@latest/+esm"

    const imgs = document.querySelectorAll('#article-img')

    const range = (min, max) => Math.random() * (max - min) + min
    
    inView(imgs, (el) => animate(el, {height: [0, '100%']}, { duration: range(0.5, 2.5)}))
</script>